# Copy to .env and fill in real values. Never commit the real .env file.

PORT=3000

# Required in production. Requests to /api/* must send this as the x-api-key header.
# If unset, the admin API is unauthenticated (development only).
MW_ADMIN_API_KEY=change-me

# Required in production. Used to derive the AES-256 key that encrypts stored
# integration credentials (Twilio, WhatsApp, Telegram, Vapi, Zoom, Apollo).
# Generate one with: openssl rand -hex 32
# If unset, a random per-process key is used and stored secrets are lost on restart.
MW_CREDENTIALS_KEY=

# Optional. Postgres/Supabase connection string. When set, integration
# credentials and custom markets are persisted via Postgres (see
# migrations/001_init.sql); when unset, they are kept in memory only.
DATABASE_URL=
